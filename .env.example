# Copy this file to .env and fill in your values
# Never commit .env to version control

# --- Required ---
OPENAI_API_KEY=sk-...

# --- Database (overridden by docker-compose for local dev) ---
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# --- Redis (overridden by docker-compose for local dev) ---
REDIS_URL=redis://localhost:6379

# --- Auth (leave blank to use dev bypass mode) ---
# JWKS_URL=https://login.microsoftonline.com/{tenant_id}/discovery/v2.0/keys
# JWT_AUDIENCE=api://your-app-id

# --- Models ---
EMBEDDING_MODEL=text-embedding-3-large
STT_MODEL=gpt-4o-transcribe
LLM_MODEL=gpt-4o

# --- Cache ---
CACHE_TTL=600

# --- Observability (optional) ---
# OTEL_ENDPOINT=http://localhost:4317

# --- Dev ---
DEBUG=false
